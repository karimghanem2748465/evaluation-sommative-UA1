<Window x:Class="GestCoop.Views.OffresStageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GestCoop — Gestion des stages coopératifs" Width="1440" Height="960" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F2F4F8" FontFamily="Segoe UI" FontSize="13">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#22365E" Padding="20,0"><DockPanel LastChildFill="False"><TextBlock Text="GestCoop — Gestion des stages coopératifs" Foreground="White" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▣  2025–2026" Foreground="#DFE7FA" Margin="0,0,32,0" VerticalAlignment="Center"/><Border Background="#E9EEFA" CornerRadius="18" Padding="8"><TextBlock Text="KA" FontWeight="Bold"/></Border><StackPanel Margin="10,0,14,0"><TextBlock Text="K. Aladji" Foreground="White"/><TextBlock Text="Coordonnateur" Foreground="#BDC9E3" FontSize="11"/></StackPanel></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#22365E" Padding="12,24"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="8"><TextBlock Text="K. Aladji" Foreground="White"/><TextBlock Text="Coordonnateur" Foreground="#B8C6E0" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="GestiCoop" Foreground="White" FontWeight="Bold" FontSize="22" Margin="8,0,0,4"/><TextBlock Text="Stages coopératifs" Foreground="#B8C6E0" Margin="8,0,0,35"/><TextBlock Text="PRINCIPAL" FontSize="10" Foreground="#95A6C8" Margin="8,0,0,14"/><Button Content="⌂  Tableau de bord" Click="Navigation_Click" Tag="Tableau de bord" Margin="0,3" Background="Transparent" Foreground="#CBD5E9" BorderBrush="Transparent" HorizontalContentAlignment="Left"/><Button Content="▣  Offres de stage" Background="#324F85" Foreground="White" BorderBrush="Transparent" Margin="0,3" Click="Offres_Click"/><Button Content="♧  Étudiants" Click="Navigation_Click" Tag="Étudiants" Background="Transparent" Foreground="#CBD5E9" BorderBrush="Transparent" Margin="0,3"/><Button Content="▤  Candidatures" Click="Navigation_Click" Tag="Candidatures" Background="Transparent" Foreground="#CBD5E9" BorderBrush="Transparent" Margin="0,3"/><Button Content="▥  Entreprises" Click="Navigation_Click" Tag="Entreprises" Background="Transparent" Foreground="#CBD5E9" BorderBrush="Transparent" Margin="0,3"/></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
    <TextBlock Text="Offres de stage" FontSize="26" FontWeight="Bold"/><TextBlock Text="Publier une nouvelle offre et consulter la liste des offres existantes" Foreground="#738096" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock x:Name="FormTitle" Text="⊞  Nouvelle offre de stage" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Entreprise *" Style="{StaticResource Label}"/><ComboBox x:Name="Entreprise" IsEditable="True" ToolTip="Sélectionnez ou saisissez une entreprise"/><TextBlock Text="Titre du poste *" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox x:Name="Poste" MaxLength="100" ToolTip="Ex. : Développeur junior"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Programme(s) visé(s) *" Style="{StaticResource Label}"/><Expander Header="Sélectionner un ou plusieurs programmes…" Background="#F6F8FC" Padding="6"><StackPanel x:Name="Programmes"><CheckBox Content="Informatique" Margin="4"/><CheckBox Content="Réseautique" Margin="4"/><CheckBox Content="Administration" Margin="4"/><CheckBox Content="Génie électrique" Margin="4"/></StackPanel></Expander><TextBlock Text="Lieu de travail *" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox x:Name="Lieu" MaxLength="150" ToolTip="Ex. : Montréal, QC (hybride)"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Type de stage *" Style="{StaticResource Label}"/><ComboBox x:Name="TypeStage"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Date de début *" Style="{StaticResource Label}"/><DatePicker x:Name="Debut" SelectedDateFormat="Short"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Date de fin *" Style="{StaticResource Label}"/><DatePicker x:Name="Fin" SelectedDateFormat="Short"/></StackPanel></Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nombre de postes *" Style="{StaticResource Label}"/><TextBox x:Name="Nombre" Text="1" MaxLength="4"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Statut initial *" Style="{StaticResource Label}"/><ComboBox x:Name="Statut"/></StackPanel></Grid></StackPanel>
     </Grid>
     <TextBlock Text="Description *" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox x:Name="Description" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBlock x:Name="Compteur" Text="0 / 1000" HorizontalAlignment="Right" Foreground="#738096" Margin="0,4,0,0"/>
     <TextBlock x:Name="Erreur" Foreground="#B44040" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Réinitialiser" Click="Reinitialiser_Click" Margin="0,0,12,0"/><Button x:Name="Publier" Content="➤  Publier l'offre" Click="Publier_Click" Background="{StaticResource Blue}" Foreground="White" BorderBrush="{StaticResource Blue}" IsEnabled="False"/></StackPanel>
    </StackPanel></Border>
    <TextBlock x:Name="Notification" Foreground="#23683E" Margin="0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="Recherche" Width="235" ToolTip="Rechercher une offre : entreprise, poste, programme ou lieu" TextChanged="Recherche_Modifiee"/><ComboBox x:Name="Filtre" Width="145" Margin="12,0,0,0" SelectionChanged="Filtre_Modifie"/></StackPanel><TextBlock Text="▣  Liste des offres de stage" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/></DockPanel>
     <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E9EDF3" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="38" Background="White" SelectionMode="Single" MinHeight="200">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F0F3F8"/><Setter Property="Foreground" Value="#65728A"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="11"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.Resources>
      <DataGrid.Columns><DataGridTextColumn Header="ENTREPRISE" Binding="{Binding Entreprise}" Width="*"/><DataGridTextColumn Header="POSTE" Binding="{Binding Poste}" Width="1.15*"/><DataGridTextColumn Header="PROGRAMME" Binding="{Binding Programme}" Width="*"/><DataGridTextColumn Header="LIEU" Binding="{Binding Lieu}" Width="*"/><DataGridTextColumn Header="DÉBUT" Binding="{Binding Debut, StringFormat=yyyy-MM-dd}" Width="90"/><DataGridTextColumn Header="FIN" Binding="{Binding Fin, StringFormat=yyyy-MM-dd}" Width="90"/>
       <DataGridTemplateColumn Header="STATUT" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#DEF1E3"/><Style.Triggers><DataTrigger Binding="{Binding Statut}" Value="En révision"><Setter Property="Background" Value="#FFF0C2"/></DataTrigger><DataTrigger Binding="{Binding Statut}" Value="Expiré"><Setter Property="Background" Value="#F8DCDD"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Statut}" FontWeight="SemiBold" FontSize="11"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="ACTIONS" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Modifier" Click="Modifier_Click" Tag="{Binding}" Foreground="#28579D" BorderBrush="Transparent" Padding="4,5"/><Button Content="Supprimer" Click="Supprimer_Click" Tag="{Binding}" Foreground="#B44040" BorderBrush="Transparent" Padding="4,5"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <DockPanel Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Click="Precedent_Click" Padding="10,5"/><TextBlock x:Name="PageLabel" Background="{StaticResource Blue}" Foreground="White" Padding="12,6" Margin="6,0"/><Button Content="›" Click="Suivant_Click" Padding="10,5"/></StackPanel><TextBlock x:Name="Total" VerticalAlignment="Center" Foreground="#738096"/></DockPanel>
    </StackPanel></Border>
    <TextBlock Text="* Champs obligatoires • Les dates de la maquette sont conservées dans les exemples." Foreground="#738096" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</Window>

